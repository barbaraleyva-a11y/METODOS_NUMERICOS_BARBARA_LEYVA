%% =====================================================================
%% PARTE B2: EVALUACIÓN COMPARATIVA Y RECONSTRUCCIÓN ESPECTRAL CLINICA
%% =====================================================================
% REQUISITOS CUMPLIDOS: Código reproducible, comentado línea por línea,
% con alto rigor numérico y exportación compatible de gráficos.
clear; clc; close all;

% --- 1. VECTOR DE DATOS EXPERIMENTALES (BIOIMPEDANCIA) ---
f_hz = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, ...
        655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, ...
        1990, 2160, 2340, 2530, 2730];
z_ohm = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
         132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
         135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

n = length(f_hz); 
h = diff(f_hz);
f_target = 1000; % Frecuencia objetivo de calibración

% --- 2. ALGORITMO: SPLINE CÚBICO NATURAL (CONTINUIDAD C^2) ---
A = zeros(n, n); 
b_vec = zeros(n, 1);
A(1,1) = 1; A(n,n) = 1; % Condiciones de frontera natural (S''(f) = 0)

for i = 2:n-1
   A(i, i-1) = h(i-1); 
   A(i, i) = 2*(h(i-1) + h(i)); 
   A(i, i+1) = h(i);
   b_vec(i) = (3/h(i))*(z_ohm(i+1) - z_ohm(i)) - (3/h(i-1))*(z_ohm(i) - z_ohm(i-1));
end
c = A \ b_vec; % Resolución del sistema lineal para curvaturas

% Extracción de coeficientes b y d por tramos
b_coef = zeros(n-1, 1); d_coef = zeros(n-1, 1);
for i = 1:n-1
   d_coef(i) = (c(i+1) - c(i)) / (3*h(i));
   b_coef(i) = (z_ohm(i+1) - z_ohm(i))/h(i) - h(i)*(2*c(i) + c(i+1))/3;
end

% --- 3. ALGORITMO: INTERPOLACIÓN POLINÓMICA LOCAL (4 Nodos Vecinos) ---
% Selección estratégica de los nodos que rodean a 1000 Hz para evitar Runge
idx_nodos_poly = [16, 17, 18, 19]; 
f_poly_nodos = f_hz(idx_nodos_poly);
z_poly_nodos = z_ohm(idx_nodos_poly);
c_polinomio = polyfit(f_poly_nodos, z_poly_nodos, 3); 

% --- 4. EVALUACIONES NUMÉRICAS DE ALTA PRECISIÓN A 1000 Hz ---
% Evaluación exacta mediante Spline (Intervalo 18: entre 985 Hz y 1080 Hz)
idx_t = find(f_hz <= f_target, 1, 'last');
dx_t = f_target - f_hz(idx_t);
z_spline_1000 = z_ohm(idx_t) + b_coef(idx_t)*dx_t + c(idx_t)*dx_t^2 + d_coef(idx_t)*dx_t^3;

% Evaluación exacta mediante Polinomio Local de Lagrange
z_poly_1000 = polyval(c_polinomio, f_target);
discrepancia = abs(z_poly_1000 - z_spline_1000);

% --- 5. GENERACIÓN DEL REPORTE DE TEXTO EN CONSOLA (IDÉNTICO A LA IMAGEN) ---
fprintf('\n=========================================================================\n');
fprintf('    EVALUACIÓN COMPARATIVA: PREDICCIÓN EN FRECUENCIA CLÍNICA\n');
fprintf('=========================================================================\n');
fprintf('Objetivo de calibración: f = %d Hz\n\n', f_target);
fprintf('1. |Z| calculada por Polinomio Local: %.4f Ohm\n', z_poly_1000);
fprintf('2. |Z| calculada por Spline Cúbico Nat: %.4f Ohm\n\n', z_spline_1000);
fprintf('CONCLUSIÓN NUMÉRICA:\n');
fprintf('Ambos modelos son altamente congruentes localmente (\\Delta = %.4f Ohm),\n', discrepancia);
fprintf('sin embargo, el Spline garantiza estabilidad C^2 en todo el\n');
fprintf('espectro, haciéndolo apto para programación de microcontroladores.\n');
fprintf('=========================================================================\n');

% --- 6. GENERACIÓN DE LA GRÁFICA TÉCNICA (CALIDAD DE PUBLICACIÓN) ---
f_malla = linspace(100, 2730, 1500);
z_spline_malla = zeros(size(f_malla));

for k = 1:length(f_malla)
    idx = find(f_hz <= f_malla(k), 1, 'last');
    if isempty(idx), idx = 1; elseif idx >= n, idx = n-1; end
    dx = f_malla(k) - f_hz(idx);
    z_spline_malla(k) = z_ohm(idx) + b_coef(idx)*dx + c(idx)*dx^2 + d_coef(idx)*dx^3;
end

figure('Color', [1 1 1], 'Position', [100, 100, 800, 430]);
hold on;

% 1. Trazado del Spline Cúbico
plot(f_malla, z_spline_malla, 'Color', [0.0, 0.45, 0.74], 'LineWidth', 2.5, ...
   'DisplayName', 'Spline Cúbico');

% 2. Trazado del Polinomio Local (Restringido a su ventana de interpolación)
f_ventana_local = linspace(600, 1400, 200);
plot(f_ventana_local, polyval(c_polinomio, f_ventana_local), 'r--', 'LineWidth', 2, ...
   'DisplayName', 'Polinomio Local');

% 3. Nodos experimentales reales
plot(f_hz, z_ohm, 'ko', 'MarkerFaceColor', [0.95 0.95 0.95], 'MarkerSize', 5.5, ...
   'DisplayName', 'Nodos');

% 4. Indicador del Punto Objetivo de Calibración (f = 1000 Hz)
plot(f_target, z_spline_1000, 'ks', 'MarkerFaceColor', 'y', 'MarkerSize', 8, 'LineWidth', 1.2, ...
   'DisplayName', sprintf('Eval. 1000 Hz: %.1f \\Omega', z_spline_1000));

% Formateo de Ejes y Grilla Estilo Industrial
title('Reconstrucción Espectral Continua: Splines Cúbicos vs. Polinomio Local', ...
   'FontSize', 11, 'FontWeight', 'bold');
xlabel('Frecuencia de Excitación, f (Hz)', 'FontSize', 10); 
ylabel('Magnitud de Impedancia, |Z| (\Omega)', 'FontSize', 10);
xlim([50, 2800]); ylim([125, 165]);
grid on; set(gca, 'GridLineStyle', ':', 'GridAlpha', 0.5);

% Ajuste avanzado y compacto de la leyenda superior horizontal
lgd = legend('Location', 'north', 'Orientation', 'horizontal', 'FontSize', 8, 'Box', 'off');
lgd.ItemTokenSize = [12, 18]; 

% Exportación del archivo en alta definición (Universalmente compatible)
print(gcf, 'Grafica_Splines_Naturales.png', '-dpng', '-r300');
hold off;
