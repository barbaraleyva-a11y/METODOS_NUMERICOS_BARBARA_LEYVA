% =========================================================================
% PARTE 3: DETECCIÓN DE ALARMA (RAÍCES POR CAMBIO DE SIGNO Y BISECCIÓN)
% Métodos: Teorema de Bolzano y Bisección sobre Trazador Cúbico
% =========================================================================

clear; clc; format compact;

%% --- REGISTRO DE MEDICIONES DE LABORATORIO ---
frec_khz = [10.0, 12.5, 15.0, 17.5, 20.0, 22.5, 25.0, 27.5, 30.0, 32.5, ...
            35.0, 37.5, 40.0, 42.5, 45.0, 47.5, 50.0, 52.5, 55.0, 57.5, ...
            60.0, 62.5, 65.0, 67.5, 70.0, 72.5, 75.0, 77.5, 80.0, 82.5, ...
            85.0, 87.5, 90.0, 92.5, 95.0, 97.5, 100.0, 102.5, 105.0, 107.5];

volt_v   = [0.842, 0.911, 0.986, 1.062, 1.143, 1.227, 1.314, 1.401, 1.482, 1.551, ...
            1.216, 1.048, 0.866, 0.689, 0.521, 0.364, 0.223, 0.103, 0.012, -0.041, ...
            -0.057, -0.034, 0.018, 0.096, 0.197, 0.318, 0.452, 0.579, 0.700, 0.809, ...
            0.611, 0.688, 0.756, 0.811, 0.856, 0.894, 0.926, 0.954, 0.980, 1.004];

% Criterio de parada para convergencia estricta
umbral_error = 1e-5; 

%% --- 1. LOCALIZACIÓN DEL PRIMER CAMBIO DE SIGNO ---
idx_cambio = 0;
for k = 1:(length(volt_v)-1)
    if volt_v(k) * volt_v(k+1) < 0
        idx_cambio = k;
        break; % Detenemos al hallar el primer cruce
    end
end

f_inf = frec_khz(idx_cambio);
f_sup = frec_khz(idx_cambio+1);

fprintf('=================================================================\n');
fprintf('PROCESO 3: RAÍCES POR CAMBIO DE SIGNO Y BISECCIÓN (PRIMER CRUCE)\n');
fprintf('=================================================================\n');
fprintf('  > Primer intervalo con cambio de signo detectado:\n');
fprintf('    f_inferior = %.1f kHz (V = %.3f V)\n', f_inf, volt_v(idx_cambio));
fprintf('    f_superior = %.1f kHz (V = %.3f V)\n\n', f_sup, volt_v(idx_cambio+1));

%% --- 2. APLICACIÓN DEL MÉTODO DE BISECCIÓN SOBRE EL SPLINE ---
lim_a = f_inf;
lim_b = f_sup;

while (lim_b - lim_a) / 2 > umbral_error
    f_medio = (lim_a + lim_b) / 2;
    
    v_a = evaluar_spline_global(frec_khz, volt_v, lim_a);
    v_m = evaluar_spline_global(frec_khz, volt_v, f_medio);
    
    if v_m == 0
        lim_a = f_medio; lim_b = f_medio;
        break;
    elseif v_a * v_m < 0
        lim_b = f_medio; % La raíz está en el subintervalo izquierdo
    else
        lim_a = f_medio; % La raíz está en el subintervalo derecho
    end
end

f_raiz1 = (lim_a + lim_b) / 2;
fprintf('  > Frecuencia de corte calculada (Raíz 1): %.4f kHz\n', f_raiz1);
fprintf('=================================================================\n');


%% =========================================================================
%% FUNCIONES AUXILIARES
%% =========================================================================

function imagen_v = evaluar_spline_global(x, y, x_eval)
    % Reconstrucción del Spline Cúbico Natural para evaluación continua
    n = length(x) - 1;
    h_pasos = diff(x);
    
    A_mat = zeros(1, n+1); B_mat = ones(1, n+1); C_mat = zeros(1, n+1); D_mat = zeros(1, n+1);
    for j = 2:n
        A_mat(j) = h_pasos(j-1) / 6.0;
        B_mat(j) = (h_pasos(j-1) + h_pasos(j)) / 3.0;
        C_mat(j) = h_pasos(j) / 6.0;
        D_mat(j) = ((y(j+1) - y(j)) / h_pasos(j)) - ((y(j) - y(j-1)) / h_pasos(j-1));
    end
    
    % Resolución por algoritmo de Thomas
    cp = zeros(1, n+1); dp = zeros(1, n+1);
    cp(1) = C_mat(1) / B_mat(1); dp(1) = D_mat(1) / B_mat(1);
    for j = 2:n+1
        den = B_mat(j) - A_mat(j) * cp(j-1);
        if j < n+1, cp(j) = C_mat(j) / den; end
        dp(j) = (D_mat(j) - A_mat(j) * dp(j-1)) / den;
    end
    M = zeros(1, n+1); M(n+1) = dp(n+1);
    for j = n:-1:1, M(j) = dp(j) - cp(j) * M(j+1); end
    
    % Ubicación del tramo
    tramo_id = 1;
    for j = 1:n
        if (x(j) <= x_eval) && (x_eval <= x(j+1))
            tramo_id = j;
            break;
        end
    end
    
    h_l = h_pasos(tramo_id);
    comp1 = M(tramo_id) * ((x(tramo_id+1) - x_eval)^3) / (6.0 * h_l);
    comp2 = M(tramo_id+1) * ((x_eval - x(tramo_id))^3) / (6.0 * h_l);
    comp3 = (y(tramo_id) - (M(tramo_id) * (h_l^2)) / 6.0) * ((x(tramo_id+1) - x_eval) / h_l);
    comp4 = (y(tramo_id+1) - (M(tramo_id+1) * (h_l^2)) / 6.0) * ((x_eval - x(tramo_id)) / h_l);
    
    imagen_v = comp1 + comp2 + comp3 + comp4;
end
