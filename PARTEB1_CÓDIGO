%% =====================================================================
%% PARTE B: RECONSTRUCCIÓN ESPECTRAL 
%% =====================================================================
% Requisitos formales: Código autocontenido, reproducible y comentado.
clear; clc; close all;

% --- 1. SET DE DATOS EXPERIMENTALES (BIOIMPEDANCIA) ---
f_hz = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, ...
        655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, ...
        1990, 2160, 2340, 2530, 2730];
z_ohm = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
         132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
         135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

N = length(f_hz);
f_target = 1000;

% --- 2. MODELADO NUMÉRICO MATRICIAL Y ESCALONADO ---
V = vander(f_hz);
coefs_p29 = V \ z_ohm'; % Polinomio Global de Grado 29

coefs_g15 = polyfit(f_hz, z_ohm, 15);
coefs_g10 = polyfit(f_hz, z_ohm, 10);
coefs_g5  = polyfit(f_hz, z_ohm, 5);

% --- 3. CONSTRUCCIÓN MATEMÁTICA DEL SPLINE CÚBICO NATURAL ---
h_inter = diff(f_hz);
A_mat = zeros(N, N); 
b_vec = zeros(N, 1);
A_mat(1,1) = 1; A_mat(N,N) = 1; 

for i = 2:N-1
   A_mat(i, i-1) = h_inter(i-1); 
   A_mat(i, i) = 2*(h_inter(i-1) + h_inter(i)); 
   A_mat(i, i+1) = h_inter(i);
   b_vec(i) = (3/h_inter(i))*(z_ohm(i+1) - z_ohm(i)) - (3/h_inter(i-1))*(z_ohm(i) - z_ohm(i-1));
end
c_coef = A_mat \ b_vec; 

b_coef = zeros(N-1, 1); d_coef = zeros(N-1, 1);
for i = 1:N-1
   d_coef(i) = (c_coef(i+1) - c_coef(i)) / (3*h_inter(i));
   b_coef(i) = (z_ohm(i+1) - z_ohm(i))/h_inter(i) - h_inter(i)*(2*c_coef(i) + c_coef(i+1))/3;
end

% --- 4. REPORTE TÉCNICO EN CONSOLA (PARTE B1) ---
fprintf('\n=========================================================================\n');
fprintf(' [MÉTODO 1: POLINOMIO UNIFORME MATRICIAL]\n');
fprintf('=========================================================================\n');
fprintf('1. Modelo Matemático de Ajuste:\n');
fprintf('   P_29(f) = c_0 + c_1*f + c_2*f^2 + ... + c_29*f^29\n\n');
fprintf('2. Estructura del Sistema Lineal Acoplado (V * c = |Z|):\n');
fprintf('   |   1     f_1     f_1^2   ...    f_1^29  |   |  c_0  |   | |Z|_1  |\n');
fprintf('   |   1     f_2     f_2^2   ...    f_2^29  | * |  c_1  | = | |Z|_2  |\n');
fprintf('   |  ...    ...      ...    ...      ...   |   |  ...  |   |  ...   |\n');
fprintf('   |   1     f_30    f_30^2  ...    f_30^29 |   | c_29  |   | |Z|_30 |\n\n');
fprintf('3. Dimensión y Consistencia del Sistema:\n');
fprintf('   - Dimensión de la Matriz de Vandermonde: %d x %d\n', N, N);
fprintf('   - Inestabilidad Numérica (Número de condición K(V)): %.4e\n', cond(V));
fprintf('-------------------------------------------------------------------------\n');
fprintf(' [MÉTODO 2: INTERPOLACIÓN POR EL MÉTODO DE LAGRANGE]\n');
fprintf('-------------------------------------------------------------------------\n');
fprintf('1. Modelo Matemático de Ajuste:\n');
fprintf('   P_29(f) = %s (from i=1 to 30) |Z|_i * L_i(f)\n\n', char(931));
fprintf('2. Formulación del Polinomio Base de Lagrange L_i(f):\n');
fprintf('   L_i(f) = %s (from j%si to 30) (f - f_j) / (f_i - f_j)\n', char(928), char(8800));
fprintf('   - Número de polinomios base L_i(f) en memoria: %d\n', N);
fprintf('   - Grado algebraico de cada polinomio base L_i(f): %d\n', N - 1);

% --- 6. GENERACIÓN DE GRÁFICA OPTIMIZADA (LEYENDA CORREGIDA EN LA ESQUINA) ---
f_malla = linspace(min(f_hz), max(f_hz), 1000);

% Evaluación del spline en la malla fina
z_spline_malla = zeros(size(f_malla));
for k = 1:length(f_malla)
    idx = find(f_hz <= f_malla(k), 1, 'last');
    if isempty(idx), idx = 1; elseif idx >= N, idx = N-1; end
    dx = f_malla(k) - f_hz(idx);
    z_spline_malla(k) = z_ohm(idx) + b_coef(idx)*dx + c_coef(idx)*dx^2 + d_coef(idx)*dx^3;
end

% Configuración de la ventana gráfica
figure('Color', [1 1 1], 'Position', [150, 150, 900, 550]);
hold on;

% Trazado de curvas de polinomios (Capas inferiores)
plot(f_malla, polyval(coefs_p29, f_malla), 'Color', [0.85, 0.15, 0.15], 'LineWidth', 1.0, 'DisplayName', 'Polinomio Global (Grado 29)');
plot(f_malla, polyval(coefs_g5, f_malla), 'Color', [0.12, 0.47, 0.71], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 5');
plot(f_malla, polyval(coefs_g10, f_malla), 'Color', [1.0, 0.50, 0.05], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 10');
plot(f_malla, polyval(coefs_g15, f_malla), 'Color', [0.17, 0.63, 0.17], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 15');

% Spline Cúbico Natural con estilo de guiones discretos (-- gris)
plot(f_malla, z_spline_malla, '--', 'Color', [0.5, 0.5, 0.5], 'LineWidth', 2.0, 'DisplayName', 'Spline Cúbico Natural');

% Nodos experimentales (Círculos negros arriba de todo)
plot(f_hz, z_ohm, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 5.5, 'DisplayName', 'Datos Experimentales');

% Estructuración de etiquetas y límites
title('Comparativa de Modelos: Interpolación Polinómica Global vs. Spline Cúbico Natural', 'FontSize', 11, 'FontWeight', 'bold');
xlabel('Frecuencia f (Hz)', 'FontSize', 10); 
ylabel('Magnitud de Impedancia |Z| (\Omega)', 'FontSize', 10);
xlim([50, 2800]); 
ylim([100, 180]); 

% Ajuste sutil de la cuadrícula
grid on; 
set(gca, 'GridLineStyle', ':', 'GridAlpha', 0.4);

