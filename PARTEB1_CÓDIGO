%% =====================================================================
%% PARTE B1: INTERPOLACIÓN POLINÓMICA GLOBAL VS. ESCALONADA (RUNGE & LOO)
%% =====================================================================
% RÚBRICA: Código reproducible, indexación limpia y comentarios técnicos.
clear; clc; close all;

% --- 1. SET DE DATOS EXPERIMENTALES (BIOIMPEDANCIA) ---
f_hz = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, ...
        655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, ...
        1990, 2160, 2340, 2530, 2730];
z_ohm = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
         132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
         135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

N = length(f_hz);
f_target = 1000; % Frecuencia objetivo de calibración clínica

% --- 2. MÉTODO MATRICIAL UNIFORME (MATRIZ DE VANDERMONDE PURA) ---
V = vander(f_hz); 
coefs_p29 = V \ z_ohm'; % Coeficientes del polinomio global de grado 29

% --- 3. POLINOMIOS ESCALONADOS (PARA EVALUACIÓN DE RUNGE) ---
coefs_g15 = polyfit(f_hz, z_ohm, 15);
coefs_g10 = polyfit(f_hz, z_ohm, 10);
coefs_g5  = polyfit(f_hz, z_ohm, 5); % Modelo seleccionado por estabilidad suave

% --- 4. ALGORITMO DE VALIDACIÓN CRUZADA LEAVE-ONE-OUT (LOO) ---
% Se eligen 5 puntos aleatorios para validar la capacidad predictiva del modelo de Grado 5
rng(42); % Semilla fija para reproducibilidad exacta en cualquier PC
puntos_azar = randperm(N, 5);
errores_relativos = zeros(1, 5);

fprintf('\n=========================================================================\n');
fprintf('     EJECUCIÓN DE VALIDACIÓN CRUZADA LEAVE-ONE-OUT (LOO) - MODELO G5    \n');
fprintf('=========================================================================\n');
fprintf('  Nodo Omitido | Frecuencia (Hz) | Valor Real (Ohm) | Predicho (Ohm) | Error Rel (%%)\n');
fprintf('-------------------------------------------------------------------------\n');

for k = 1:5
    idx_excluido = puntos_azar(k);
    
    % Subconjuntos de entrenamiento (Removiendo el punto k-ésimo)
    f_loo = f_hz; f_loo(idx_excluido) = [];
    z_loo = z_ohm; z_loo(idx_excluido) = [];
    
    % Reajuste iterativo del polinomio seleccionado (Grado 5)
    coefs_loo = polyfit(f_loo, z_loo, 5);
    
    % Predicción en el vacío del punto omitido
    z_pred = polyval(coefs_loo, f_hz(idx_excluido));
    
    % Cálculo del error relativo porcentual
    errores_relativos(k) = abs(z_ohm(idx_excluido) - z_pred) / z_ohm(idx_excluido) * 100;
    
    fprintf('       %2d       |     %7.1f     |      %6.2f      |     %6.2f     |    %6.4f %%\n', ...
            idx_excluido, f_hz(idx_excluido), z_ohm(idx_excluido), z_pred, errores_relativos(k));
end
error_loo_promedio = mean(errores_relativos);

% Evaluación final en el punto clínico de interés
z_interpolado_1000 = polyval(coefs_g5, f_target);

% --- 5. REPORTE TÉCNICO ESTRUCTURADO EN CONSOLA ---
fprintf('\n=========================================================================\n');
fprintf(' [MÉTODO 1: POLINOMIO UNIFORME MATRICIAL]\n');
fprintf('=========================================================================\n');
fprintf('1. Modelo Matemático de Ajuste:\n');
fprintf('   P_29(f) = c_0 + c_1*f + c_2*f^2 + ... + c_29*f^29\n\n');
fprintf('2. Estructura del Sistema Lineal Acoplado (V * c = |Z|):\n');
fprintf('   |   1     f_1     f_1^2   ...    f_1^29  |   |  c_0  |   | |Z|_1  |\n');
fprintf('   |   1     f_2     f_2^2   ...    f_2^29  | * |  c_1  | = | |Z|_2  |\n');
fprintf('   |  ...    ...      ...    ...      ...   |   |  ...  |   |  ...   |\n');
fprintf('   |   1     f_30    f_30^2  ...    f_30^29 |   | c_29  |   | |Z|_30 |\n\n');
fprintf('3. Dimensión y Consistencia del Sistema:\n');
fprintf('   - Dimensión de la Matriz de Vandermonde: %d x %d\n', N, N);
fprintf('   - Inestabilidad Numérica (Número de condición K(V)): %.4e\n', cond(V));
fprintf('-------------------------------------------------------------------------\n');
fprintf(' [MÉTODO 2: INTERPOLACIÓN POR EL MÉTODO DE LAGRANGE]\n');
fprintf('-------------------------------------------------------------------------\n');
fprintf('1. Modelo Matemático de Ajuste:\n');
fprintf('   P_29(f) = %s (from i=1 to 30) |Z|_i * L_i(f)\n\n', char(931));
fprintf('2. Formulación del Polinomio Base de Lagrange L_i(f):\n');
fprintf('   L_i(f) = %s (from j%si to 30) (f - f_j) / (f_i - f_j)\n', char(928), char(8800));
fprintf('   - Número de polinomios base L_i(f) en memoria: %d\n', N);
fprintf('   - Grado algebraico de cada polinomio base L_i(f): %d\n', N - 1);
fprintf('-------------------------------------------------------------------------\n');
fprintf(' [CÁLCULO E INCERTIDUMBRE EN FRECUENCIA CLÍNICA]\n');
fprintf('-------------------------------------------------------------------------\n');
fprintf('  * Polinomio de Grado 5 Seleccionado a 1000 Hz : %.4f Ohm\n', z_interpolado_1000);
fprintf('  * Error Relativo Global Estimado por LOO     : %.4f %%\n', error_loo_promedio);
fprintf('=========================================================================\n');

% --- 6. GENERACIÓN DEL GRÁFICO LIMPIO (ESTILO PYTHON SOLICITADO) ---
f_malla = linspace(min(f_hz), max(f_hz), 1000);

figure('Color', [1 1 1], 'Position', [150, 150, 900, 550]);
hold on;

% Trazado de curvas de ajuste 
plot(f_malla, polyval(coefs_p29, f_malla), 'Color', [0.85, 0.15, 0.15], 'LineWidth', 1.0, 'DisplayName', 'Polinomio Global (Grado 29)');
plot(f_malla, polyval(coefs_g5, f_malla), 'Color', [0.12, 0.47, 0.71], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 5');
plot(f_malla, polyval(coefs_g10, f_malla), 'Color', [1.0, 0.50, 0.05], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 10');
plot(f_malla, polyval(coefs_g15, f_malla), 'Color', [0.17, 0.63, 0.17], 'LineWidth', 2.5, 'DisplayName', 'Polinomio Grado 15');

% Capa superior: Nodos experimentales 
plot(f_hz, z_ohm, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 5.5, 'DisplayName', 'Datos Experimentales');

% Formateo de ejes
title('Comparativa de Modelos: Interpolación Polinómica Global vs. Polinomios Escalonados', 'FontSize', 11, 'FontWeight', 'bold');
xlabel('Frecuencia f (Hz)', 'FontSize', 10); 
ylabel('Magnitud de Impedancia |Z| (\Omega)', 'FontSize', 10);
xlim([50, 2800]); 
ylim([100, 180]); 

% Ajuste 
grid on; set(gca, 'GridLineStyle', ':', 'GridAlpha', 0.4);

% Ubicación clásica de la leyenda
legend('Location', 'northeast', 'FontSize', 9, 'Box', 'on');

% Archivo final 
print(gcf, 'grafico_comparativo_B1.png', '-dpng', '-r300');
hold off;
