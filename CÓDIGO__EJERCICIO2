function valor_aprox = interpolacion_lagrange2(p_objetivo, x_datos, y_datos, etiqueta)
    % Determinación de índices específicos de vecindad fija para replicar tramos continuos
    if p_objetivo == 41.0
        nodos = [12, 13, 14]; % Índices para frecuencias [37.5, 40.0, 42.5]
    else
        nodos = [25, 26, 27]; % Índices para frecuencias [70.0, 72.5, 75.0]
    end
    
    x0 = x_datos(nodos(1)); x1 = x_datos(nodos(2)); x2 = x_datos(nodos(3));
    y0 = y_datos(nodos(1)); y1 = y_datos(nodos(2)); y2 = y_datos(nodos(3));
    
    % Polinomios base de soporte de Lagrange
    L0 = ((p_objetivo - x1) * (p_objetivo - x2)) / ((x0 - x1) * (x0 - x2));
    L1 = ((p_objetivo - x0) * (p_objetivo - x2)) / ((x1 - x0) * (x1 - x2));
    L2 = ((p_objetivo - x0) * (p_objetivo - x1)) / ((x2 - x0) * (x2 - x1));
    
    valor_aprox = (L0 * y0) + (L1 * y1) + (L2 * y2);
    
    fprintf('  > Nodos [%.1f, %.1f, %.1f] -> L0=%.4f, L1=%.4f, L2=%.4f -> %s(%.1f kHz) = %.4f\n', ...
            x0, x1, x2, L0, L1, L2, etiqueta, p_objetivo, valor_aprox);
end

function vec_sol = resolucion_thomas(diag_inf, diag_med, diag_sup, term_ind)
    num_nodos = length(term_ind);
    c_mod = zeros(1, num_nodos); 
    d_mod = zeros(1, num_nodos);
    
    c_mod(1) = diag_sup(1) / diag_med(1);
    d_mod(1) = term_ind(1) / diag_med(1);
    
    % Algoritmo de barrido de eliminación hacia adelante
    for k = 2:num_nodos
        w = diag_med(k) - diag_inf(k) * c_mod(k-1);
        if k < num_nodos
            c_mod(k) = diag_sup(k) / w;
        end
        d_mod(k) = (term_ind(k) - diag_inf(k) * d_mod(k-1)) / w;
    end
    
    % Sustitución regresiva para determinar las incógnitas
    vec_sol = zeros(1, num_nodos);
    vec_sol(num_nodos) = d_mod(num_nodos);
    for k = (num_nodos-1):-1:1
        vec_sol(k) = d_mod(k) - c_mod(k) * vec_sol(k+1);
    end
end

function estimacion = interpolacion_spline(x, y, objetivo, etiqueta)
    puntos = length(x) - 1;
    h_pasos = diff(x); 
    
    A_diag = zeros(1, puntos+1); 
    B_diag = ones(1, puntos+1); 
    C_diag = zeros(1, puntos+1); 
    R_ind  = zeros(1, puntos+1);
    
    % Ensamble del sistema tridiagonal de momentos (continuidad de la derivada segunda)
    for j = 2:puntos
        A_diag(j) = h_pasos(j-1) / 6.0;
        B_diag(j) = (h_pasos(j-1) + h_pasos(j)) / 3.0;
        C_diag(j) = h_pasos(j) / 6.0;
        R_ind(j)  = ((y(j+1) - y(j)) / h_pasos(j)) - ((y(j) - y(j-1)) / h_pasos(j-1));
    end
    
    M = resolucion_thomas(A_diag, B_diag, C_diag, R_ind);
    
    % Localización del intervalo de pertenencia del punto analizado
    idx_tramo = 1;
    for j = 1:puntos
        if (x(j) <= objetivo) && (objetivo <= x(j+1))
            idx_tramo = j;
            break;
        end
    end
    
    h_loc = h_pasos(idx_tramo);
    
    % Modelo cúbico segmentado empleando las curvaturas nodales (M)
    comp_a = M(idx_tramo) * ((x(idx_tramo+1) - objetivo)^3) / (6.0 * h_loc);
    comp_b = M(idx_tramo+1) * ((objetivo - x(idx_tramo))^3) / (6.0 * h_loc);
    comp_c = (y(idx_tramo) - (M(idx_tramo) * (h_loc^2)) / 6.0) * ((x(idx_tramo+1) - objetivo) / h_loc);
    comp_d = (y(idx_tramo+1) - (M(idx_tramo+1) * (h_loc^2)) / 6.0) * ((objetivo - x(idx_tramo)) / h_loc);
    
    estimacion = comp_a + comp_b + comp_c + comp_d;
    
    % Mapeo
    fprintf('  > Tramo %d [%.1f a %.1f] -> M[%d]=%.4f, M[%d]=%.4f -> %s(%.1f kHz) = %.4f\n', ...
            idx_tramo-1, x(idx_tramo), x(idx_tramo+1), idx_tramo-1, M(idx_tramo), idx_tramo, M(idx_tramo+1), etiqueta, objetivo, estimacion);
end
